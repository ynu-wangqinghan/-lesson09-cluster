# 四特征标准化 + KMeans(k=4)，簇编号写回 df，输出各簇人数
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

df = pd.read_csv("data/bank_customers.csv")

features = ["balance", "avg_monthly_spend", "product_count", "overdue_count"]
X = StandardScaler().fit_transform(df[features])

km = KMeans(n_clusters=4, random_state=42, n_init=10)
df["cluster"] = km.fit_predict(X)

counts = df["cluster"].value_counts().sort_index()
pct = counts / len(df) * 100

print(f"样本数：{len(df)}")
print("各簇人数：")
for c in counts.index:
    print(f"  簇 {c}：{counts[c]} 人（{pct[c]:.1f}%）")
print(f"inertia（标准化坐标）：{km.inertia_:.2f}")
